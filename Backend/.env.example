# OWN AI backend - copy to .env

# database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.awuxrmgphnawphohzdwy.supabase.co:5432/postgres
DB_AUTO_CREATE_TABLES=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
# pooler: postgresql://postgres.awuxrmgphnawphohzdwy:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# app
APP_NAME=OWN AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
API_V1_PREFIX=/api/v1
PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
LOG_JSON=false

# auth
JWT_SECRET=dev-insecure-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_MIN_LENGTH=8
SUPABASE_JWT_SECRET=

# rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60

# redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=true

# voice
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saarika:v2
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_CHAT_MODEL=sarvam-m
SARVAM_DEFAULT_SPEAKER=shubh
SARVAM_TIMEOUT_SECONDS=30

# voice agents
SARVAM_AGENTS_BASE_URL=https://apps.sarvam.ai/api/app-authoring
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_AGENT_APP_ID=
SARVAM_AGENT_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=

# telephony
TELEPHONY_PROVIDER=sarvam
TELEPHONY_WEBHOOK_SECRET=change-me
TELEPHONY_SIP_DOMAIN=
TELEPHONY_SIP_USERNAME=
TELEPHONY_SIP_PASSWORD=
TELEPHONY_OUTBOUND_ENABLED=false



# whatsapp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_API_VERSION=v21.0

# sheets
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=

# meta
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=change-me-meta-verify
META_PAGE_ACCESS_TOKEN=

# calendly
CALENDLY_API_TOKEN=
CALENDLY_EVENT_TYPE_URI=

# zoom
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# n8n
N8N_BASE_URL=
N8N_API_KEY=
N8N_LEAD_WEBHOOK_URL=
N8N_FOLLOWUP_WEBHOOK_URL=

# sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
