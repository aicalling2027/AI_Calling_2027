# Public Supabase values. Copy this file to .env.local and fill both lines.
# Supabase -> Project Settings -> API keys -> the publishable key (sb_publishable_...).
# The older "anon" name is also accepted by the app: NEXT_PUBLIC_SUPABASE_ANON_KEY.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Razorpay payment pages - the destination of the "Pay Now" buttons on the
# landing rate card. Create one page per paid plan in the dashboard
# (Payment Pages -> Create; test mode first), then paste the page URL here.
# Use the test-mode pages while RAZORPAY_KEY_ID in Backend/.env starts with
# rzp_test_, and swap both to live together. Left empty, the card falls back to
# "Request a quote" so no button ever leads to a checkout that cannot charge.
NEXT_PUBLIC_RAZORPAY_PAY_BASIC_URL=
NEXT_PUBLIC_RAZORPAY_PAY_POPULAR_URL=
