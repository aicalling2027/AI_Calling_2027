# Public Supabase values. Copy this file to .env.local and fill both lines.
# Supabase -> Project Settings -> API keys -> the publishable key (sb_publishable_...).
# The older "anon" name is also accepted by the app: NEXT_PUBLIC_SUPABASE_ANON_KEY.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
